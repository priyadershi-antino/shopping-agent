# Copy to .env and fill in. Never commit .env.

ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/shopping_agent
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/shopping_agent_test
# Evaluation database, WIPED before every scenario (empty = TEST_DATABASE_URL)
EVAL_DATABASE_URL=

# Redis (running in WSL is fine; it is reachable on 127.0.0.1)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=sa:

API_HOST=127.0.0.1
API_PORT=8000
# Optional shared secret for remote deployments. Leave empty for local use.
API_KEY=

# --- Data providers ---
# "auto" uses real providers whose keys are set, otherwise the FICTIONAL demo catalog.
# Or list them explicitly in priority order, e.g. PRODUCT_PROVIDERS=serpapi
PRODUCT_PROVIDERS=auto
WEB_PROVIDERS=auto
# Platforms whose listings are used unless a request picks others (the web form has
# checkboxes; the CLI has --platform). Names: amazon, flipkart, croma, reliance_digital,
# vijay_sales, tata_cliq, other. Empty = all, including small resellers.
DEFAULT_PLATFORMS=amazon,flipkart,croma,reliance_digital,vijay_sales,tata_cliq
# https://serpapi.com (Google Shopping India, Amazon product lookup) — free tier available
SERPAPI_API_KEY=
# https://tavily.com (web search for reviews, offers, sale news) — free tier available
TAVILY_API_KEY=
# Daily request budgets so free tiers aren't exhausted (counted per IST day in Redis)
SERPAPI_DAILY_QUOTA=8
TAVILY_DAILY_QUOTA=30
PROVIDER_TIMEOUT_S=20

# --- Language model ---
# Routes are "provider:model". Providers: gemini, groq, openrouter, openai, nvidia, ollama, anthropic.
# Free default: Gemini via Google AI Studio. Switching to a premium model is a config change only,
# e.g. LLM_MODEL=anthropic:claude-opus-5-5 (needs ANTHROPIC_API_KEY).
LLM_MODEL=gemini:gemini-flash-latest
# Tried in order when the primary fails (free tiers are often overloaded or out of daily quota).
# NVIDIA (build.nvidia.com) is a free-tier fallback that needs NVIDIA_API_KEY; remove it if you have no key.
LLM_FALLBACKS=gemini:gemini-flash-lite-latest,nvidia:openai/gpt-oss-20b
# Optional per-role overrides, e.g. a premium model only for the final answer:
LLM_MODEL_EXTRACTION=
LLM_MODEL_RESEARCH=
LLM_MODEL_SYNTHESIS=
LLM_MODEL_ANALYSIS=
LLM_REQUESTS_PER_MINUTE=10
LLM_REASONING_EFFORT=low
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
ANTHROPIC_EFFORT=medium
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Agent budgets (per request) ---
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_SECONDS=150

# --- Page fetching ---
# Extra domains the agent may read, in addition to the built-in allowlist
# (manufacturers, review sites, banks, official platform news). Comma-separated.
FETCH_EXTRA_DOMAINS=
FETCH_MAX_BYTES=2000000
FETCH_MAX_CHARS=8000

# --- Tracking, alerts and notifications (shop worker run) ---
WORKER_TICK_SECONDS=60
# Price checks per hour across all tracked items; keep within provider quotas
MONITOR_CHECKS_PER_HOUR=30
ALERT_COOLDOWN_HOURS=6
# No email/Telegram during these IST hours, e.g. 23-7 (in-app alerts still appear)
QUIET_HOURS=
# Extra channels besides in-app: email, telegram
NOTIFY_CHANNELS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
